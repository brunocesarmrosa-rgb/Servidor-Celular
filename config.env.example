# IP do celular na rede Wi-Fi (Configurações > Sobre > Status, ou: adb shell ip addr show wlan0)
PHONE_IP=192.168.0.50
ADB_PORT=5555
SSH_PORT=8022

# Modelo (padrão: bom em português, leve). Alternativas em docs/MODELOS.md
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
THREADS=4
CTX=1024

# Gateway
API_KEY=troque-por-uma-chave-longa
ALLOWED_ORIGINS=https://seusite.com.br,https://www.seusite.com.br
RATE_PER_MIN=12
MAX_CONCURRENT=1

# Cloudflare Tunnel (token gerado no painel Zero Trust > Networks > Tunnels)
# (legado) CF_TUNNEL_TOKEN=
# PUBLIC_HOSTNAME=taikazet.seusite.com.br

# --- Ponte "caixa de correio" (recomendado) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=   # secreta: fica SÓ no celular
# --- Telegram (opcional) ---
TELEGRAM_TOKEN=
